# URL do projeto Supabase (Project Settings > Data API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública anônima do Supabase (Project Settings > API Keys > anon public)
# Esta chave é segura no cliente: o acesso aos dados é controlado por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Notificações push (opcional) ---
# Sem estas variáveis o app funciona normalmente; só a tela de notificações
# aparece desativada.

# Chaves VAPID. Gere o par uma única vez com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# Segredo que protege a rota do resumo diário. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# A service_role ignora o RLS. É usada em UM único lugar: a rota do resumo
# diário, que roda no servidor sem sessão de usuário e precisa varrer as
# tarefas de todos para saber o que enviar. Nunca use com prefixo
# NEXT_PUBLIC_, nunca versione, nunca use em outro lugar do código.
SUPABASE_SERVICE_ROLE_KEY=
